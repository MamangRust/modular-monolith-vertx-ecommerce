  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <source>${maven.compiler.source}</source>
            <target>${maven.compiler.target}</target>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <filters>
              <filter>
                <artifact>*:*</artifact>
                <excludes>
                  <exclude>META-INF/*.SF</exclude>
                  <exclude>META-INF/*.DSA</exclude>
                  <exclude>META-INF/*.RSA</exclude>
                </excludes>
              </filter>
            </filters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.github.os72</groupId>
          <artifactId>protoc-jar-maven-plugin</artifactId>
          <version>3.11.4</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <!-- Dependency analysis gate (dead-dependency detection).
           Run manually with: mvn dependency:analyze
           CI runs it after `mvn clean verify` (see .github/workflows/ci.yml);
           classes must already be compiled, so it is NOT bound to the lifecycle.
           failOnWarning=true turns every unused-declared / used-undeclared /
           non-test-scoped finding into a build failure. Entries below are the
           audited BASELINE of benign findings and apply to ALL modules; any NEW
           artifact not listed here fails the build and must either be declared
           (when used) or removed (when dead). Prefer declaring direct deps over
           extending these lists — the baseline should SHRINK, not grow. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <failOnWarning>true</failOnWarning>
          <ignoredUnusedDeclaredDependencies>
            <!-- Annotation processor: never referenced from bytecode. -->
            <ignoredUnusedDeclaredDependency>org.projectlombok:lombok</ignoredUnusedDeclaredDependency>
            <!-- Aggregator artifact; the API (junit-jupiter-api) is what is referenced. -->
            <ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter</ignoredUnusedDeclaredDependency>
            <!-- Runtime SLF4J backend wired via logback.xml / ServiceLoader. -->
            <ignoredUnusedDeclaredDependency>ch.qos.logback:logback-classic</ignoredUnusedDeclaredDependency>
            <!-- JDBC driver loaded at runtime (Flyway). -->
            <ignoredUnusedDeclaredDependency>org.postgresql:postgresql</ignoredUnusedDeclaredDependency>
            <!-- Vert.x tracing, configured via OpenTelemetryOptions (SPI, no direct refs). -->
            <ignoredUnusedDeclaredDependency>io.vertx:vertx-opentelemetry</ignoredUnusedDeclaredDependency>
            <!-- Runtime SCRAM-SHA-256 auth for vertx-pg-client. vertx-pg-client declares
                 it <optional>true</optional>, so it never arrives transitively and MUST
                 stay declared explicitly even though no source references it. -->
            <ignoredUnusedDeclaredDependency>com.ongres.scram:scram-client</ignoredUnusedDeclaredDependency>
            <!-- Test framework/libs inherited globally from the parent POM; unused in
                 modules that don't exercise them. -->
            <ignoredUnusedDeclaredDependency>io.vertx:vertx-junit5</ignoredUnusedDeclaredDependency>
            <ignoredUnusedDeclaredDependency>org.mockito:mockito-core</ignoredUnusedDeclaredDependency>
            <ignoredUnusedDeclaredDependency>org.mockito:mockito-junit-jupiter</ignoredUnusedDeclaredDependency>
            <ignoredUnusedDeclaredDependency>org.assertj:assertj-core</ignoredUnusedDeclaredDependency>
            <!-- io.example:common (global scope, not just db-migration): db-migration
                 declares it solely for the shared logback.xml runtime config; no
                 io.example.common.* classes are referenced there. Other modules use
                 common directly, so this entry only masks db-migration today. -->
            <ignoredUnusedDeclaredDependency>io.example:common</ignoredUnusedDeclaredDependency>
            <!-- apigateway: genuinely used by ProtoMapper (com.google.protobuf.util.
                 JsonFormat), but the analyzer never detects com.google.protobuf.util.*
                 usage, so it reports the declaration as unused. Must be declared
                 explicitly to keep JsonFormat on the fat-jar classpath. -->
            <ignoredUnusedDeclaredDependency>com.google.protobuf:protobuf-java-util</ignoredUnusedDeclaredDependency>
          </ignoredUnusedDeclaredDependencies>
          <ignoredNonTestScopedDependencies>
            <!-- Tests assert on io.grpc.Status / StatusRuntimeException (error-mapping
                 tests), but grpc-api only arrives transitively in compile scope; main
                 code never references it directly in most services. Intentionally
                 listed in BOTH this list and ignoredUsedUndeclaredDependencies
                 (apigateway/common reference it from main code). -->
            <ignoredNonTestScopedDependency>io.grpc:grpc-api</ignoredNonTestScopedDependency>
          </ignoredNonTestScopedDependencies>
          <ignoredUsedUndeclaredDependencies>
            <!-- Referenced directly by source but provided transitively by the
                 Vert.x / gRPC / OpenTelemetry / Jackson dependency graphs. -->
            <ignoredUsedUndeclaredDependency>io.vertx:vertx-core</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.vertx:vertx-auth-common</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.vertx:vertx-auth-jwt</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.vertx:vertx-grpc-common</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.vertx:vertx-grpc-client</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.vertx:vertx-redis-client</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.vertx:vertx-sql-client</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.grpc:grpc-api</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>com.google.protobuf:protobuf-java</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>com.google.guava:guava</ignoredUsedUndeclaredDependency>
            <!-- JSR-305 annotations only. -->
            <ignoredUsedUndeclaredDependency>com.google.code.findbugs:jsr305</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>com.fasterxml.jackson.core:jackson-core</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>com.fasterxml.jackson.core:jackson-databind</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.opentelemetry:opentelemetry-api</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.opentelemetry:opentelemetry-context</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>io.opentelemetry:opentelemetry-sdk-common</ignoredUsedUndeclaredDependency>
            <ignoredUsedUndeclaredDependency>org.slf4j:slf4j-api</ignoredUsedUndeclaredDependency>
            <!-- Test: junit-jupiter-api arrives transitively via junit-jupiter. -->
            <ignoredUsedUndeclaredDependency>org.junit.jupiter:junit-jupiter-api</ignoredUsedUndeclaredDependency>
          </ignoredUsedUndeclaredDependencies>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>